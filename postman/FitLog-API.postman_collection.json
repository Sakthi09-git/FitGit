            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"workoutType\": \"RUNNING\",\n  \"durationMinutes\": 30,\n  \"caloriesBurned\": -100,\n  \"workoutDate\": \"2026-09-28\"\n}"
