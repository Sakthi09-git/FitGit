{
  "info": {
    "_postman_id": "fitlog-collection-id",
    "name": "FitLog — Personal Workout and Calorie Tracker API",
    "description": "Comprehensive Postman test collection for FitLog Spring Boot + MySQL backend, including all positive CRUD routes, summaries, weekly trends, and 10 negative test scenarios.",
